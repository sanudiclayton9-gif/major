# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore - never commit real secrets.

# --- Supabase ---
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key - SECRET, server-only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Paynow (EcoCash) ---
# Register a merchant account at https://www.paynow.co.zw
# Integration ID and Key come from your Paynow merchant dashboard.
# The official SDK reads PAYNOW_INTEGRATION_ID / PAYNOW_INTEGRATION_KEY, but
# this app also accepts PAYNOW_ID / PAYNOW_KEY. Set ONE pair (not both).
PAYNOW_ID=
PAYNOW_KEY=
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=

# --- Google Gemini (AI shop assistant) ---
# Get a free API key at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Admin ---
# Whatever password you want to use to log into /admin
ADMIN_PASSWORD=

# --- Site ---
# Your real deployed URL once you have one (used for Paynow callback URLs and SEO)
# IMPORTANT: on a live deployment this MUST be your public https URL, not localhost,
# otherwise Paynow cannot reach the resultUrl callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console verification code (HTML tag method)
GOOGLE_SITE_VERIFICATION=
